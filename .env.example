# Chaves de API para os módulos de LLM
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelos do Gemini (Separação entre quem gera a bula e quem audita a bula)
# Use gemini-1.5-flash ou gemini-2.0-flash para o gerador e modelos mais fortes ou o mesmo para auditoria.
GEMINI_MODEL_GERADOR=gemini-2.5-flash
GEMINI_MODEL_AUDITOR=gemini-3.6-flash
